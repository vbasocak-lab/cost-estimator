# --- Development (local PostgreSQL) ----------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cost_estimator_dev"
# DIRECT_URL is only needed with a connection pooler (e.g. Neon/PgBouncer)

# --- Production (Neon PostgreSQL) -------------------------------------------
# DATABASE_URL="postgresql://user:pass@ep-xxx.pooler.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-secure-random-string"
NEXTAUTH_URL="http://localhost:3001"
# NEXTAUTH_URL="https://your-app.vercel.app"

# --- Seed (required in production, optional in dev) -------------------------
# SEED_ADMIN_PASSWORD="strong-admin-password"
# SEED_ESTIMATOR_PASSWORD="strong-estimator-password"
