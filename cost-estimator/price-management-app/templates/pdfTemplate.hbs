<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Price Management Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        h1 {
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f2f2f2;
        }
        .summary {
            margin-top: 30px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h1>Price Management Report</h1>
    <h2>Price Items</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            {{#each priceItems}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.name}}</td>
                <td>{{this.price}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <h2>Summary</h2>
    <div class="summary">
        Total Items: {{totalItems}}<br>
        Total Cost: {{totalCost}}
    </div>
</body>
</html>