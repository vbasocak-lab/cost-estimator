generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String    @id @default(cuid())
  legalName       String
  brandName       String?
  countryCode     String    @default("FR")
  vatNumber       String?
  currencyCode    String    @default("EUR")
  defaultLanguage String    @default("fr")
  createdAt       DateTime  @default(now())
  projects        Project[]
  users           User[]
}

model User {
  id                String           @id @default(cuid())
  firstName         String
  lastName          String
  email             String           @unique
  passwordHash      String
  role              String           @default("estimator")
  preferredLanguage String           @default("fr")
  companyId         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  priceUpdateLogs   PriceUpdateLog[]
  projects          Project[]
  reports           Report[]
  company           Company?         @relation(fields: [companyId], references: [id])
}

model Country {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  defaultCurrency      String                @default("EUR")
  defaultVatRate       Float                 @default(0.20)
  calculationRules     CalculationRule[]
  marketIndices        MarketIndex[]
  priceItems           PriceItem[]
  projects             Project[]
  regions              Region[]
  regionalCoefficients RegionalCoefficient[]
}

model Region {
  id                   String                @id @default(cuid())
  countryId            String
  code                 String
  name                 String
  coefficientDefault   Float                 @default(1.0)
  priceItems           PriceItem[]
  projects             Project[]
  country              Country               @relation(fields: [countryId], references: [id])
  regionalCoefficients RegionalCoefficient[]

  @@unique([countryId, code])
}

model ProjectType {
  id           String                   @id @default(cuid())
  code         String                   @unique
  sortOrder    Int                      @default(0)
  projects     Project[]
  translations ProjectTypeTranslation[]
}

model ProjectTypeTranslation {
  id            String      @id @default(cuid())
  projectTypeId String
  languageCode  String
  label         String
  description   String?
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id])
}

model BuildingUse {
  id           String                   @id @default(cuid())
  code         String                   @unique
  translations BuildingUseTranslation[]
  projects     Project[]
}

model BuildingUseTranslation {
  id            String      @id @default(cuid())
  buildingUseId String
  languageCode  String
  label         String
  buildingUse   BuildingUse @relation(fields: [buildingUseId], references: [id])
}

model FinishLevel {
  id                  String               @id @default(cuid())
  code                String               @unique
  coefficient         Float                @default(1.0)
  priceItems          PriceItem[]
  projectVersions     ProjectVersion[]
  qualityCoefficients QualityCoefficient[]
}

model RenovationScope {
  id              String           @id @default(cuid())
  code            String           @unique
  coefficient     Float            @default(1.0)
  priceItems      PriceItem[]
  projectVersions ProjectVersion[]
}

model EnergyStandard {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  projectVersions ProjectVersion[]
}

model StructureSystem {
  id              String           @id @default(cuid())
  code            String           @unique
  label           String
  projectVersions ProjectVersion[]
}

model Project {
  id            String           @id @default(cuid())
  companyId     String?
  ownerUserId   String
  projectName   String
  countryId     String
  regionId      String?
  city          String?
  postalCode    String?
  projectTypeId String?
  buildingUseId String?
  status        String           @default("draft")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  buildingUse   BuildingUse?     @relation(fields: [buildingUseId], references: [id])
  company       Company?         @relation(fields: [companyId], references: [id])
  country       Country          @relation(fields: [countryId], references: [id])
  owner         User             @relation(fields: [ownerUserId], references: [id])
  projectType   ProjectType?     @relation(fields: [projectTypeId], references: [id])
  region        Region?          @relation(fields: [regionId], references: [id])
  versions      ProjectVersion[]
}

model ProjectVersion {
  id                 String              @id @default(cuid())
  projectId          String
  versionNumber      Int                 @default(1)
  label              String              @default("V1")
  grossAreaM2        Float               @default(0)
  netAreaM2          Float               @default(0)
  floorsAboveGround  Int                 @default(1)
  floorsBelowGround  Int                 @default(0)
  commonAreaRatio    Float               @default(0.15)
  facadeComplexity   String              @default("standard")
  finishLevelId      String?
  energyStandardId   String?
  structureSystemId  String?
  renovationScopeId  String?
  hvacLevel          String              @default("standard")
  electricalLevel    String              @default("standard")
  heatingType        String              @default("gas")
  ventilationType    String              @default("simple")
  roofType           String              @default("pitched")
  hasElevator        Boolean             @default(false)
  contingencyRate    Float               @default(0.08)
  overheadRate       Float               @default(0.05)
  profitRate         Float               @default(0.08)
  vatRate            Float               @default(0.20)
  isCurrent          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  bathroomCount      Int                 @default(0)
  buildingAge        String?
  energyPackage      String?
  hasKitchen         Boolean             @default(false)
  siteAccess         String?
  calculationResults CalculationResult[]
  inputs             ProjectInput[]
  energyStandard     EnergyStandard?     @relation(fields: [energyStandardId], references: [id])
  finishLevel        FinishLevel?        @relation(fields: [finishLevelId], references: [id])
  project            Project             @relation(fields: [projectId], references: [id])
  renovationScope    RenovationScope?    @relation(fields: [renovationScopeId], references: [id])
  structureSystem    StructureSystem?    @relation(fields: [structureSystemId], references: [id])
  reports            Report[]
}

model ProjectInput {
  id               String         @id @default(cuid())
  projectVersionId String
  inputKey         String
  inputValue       String
  unit             String?
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
}

model CostCategory {
  id           String                    @id @default(cuid())
  code         String                    @unique
  sortOrder    Int                       @default(0)
  translations CostCategoryTranslation[]
  costLots     CostLot[]
}

model CostCategoryTranslation {
  id             String       @id @default(cuid())
  costCategoryId String
  languageCode   String
  label          String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id])
}

model CostLot {
  id                     String                  @id @default(cuid())
  categoryId             String
  code                   String                  @unique
  defaultUnit            String                  @default("m2")
  calculationMode        String                  @default("formula")
  isActive               Boolean                 @default(true)
  sortOrder              Int                     @default(0)
  resultLines            CalculationResultLine[]
  complexityCoefficients ComplexityCoefficient[]
  category               CostCategory            @relation(fields: [categoryId], references: [id])
  translations           CostLotTranslation[]
  priceItems             PriceItem[]
  qualityCoefficients    QualityCoefficient[]
  regionalCoefficients   RegionalCoefficient[]
}

model CostLotTranslation {
  id           String  @id @default(cuid())
  costLotId    String
  languageCode String
  label        String
  description  String?
  costLot      CostLot @relation(fields: [costLotId], references: [id])
}

model PriceItem {
  id                String                 @id @default(cuid())
  costLotId         String
  itemCode          String                 @unique
  referenceName     String
  unit              String
  basePriceHt       Float
  countryId         String
  regionId          String?
  finishLevelId     String?
  renovationScopeId String?
  complexityMin     Float                  @default(0)
  complexityMax     Float                  @default(999)
  validFrom         DateTime               @default(now())
  validTo           DateTime?
  sourceType        String                 @default("internal")
  sourceNote        String?
  confidenceLevel   String                 @default("medium")
  indexCode         String?
  isActive          Boolean                @default(true)
  costLot           CostLot                @relation(fields: [costLotId], references: [id])
  country           Country                @relation(fields: [countryId], references: [id])
  finishLevel       FinishLevel?           @relation(fields: [finishLevelId], references: [id])
  region            Region?                @relation(fields: [regionId], references: [id])
  renovationScope   RenovationScope?       @relation(fields: [renovationScopeId], references: [id])
  translations      PriceItemTranslation[]
  updateLogs        PriceUpdateLog[]
}

model PriceItemTranslation {
  id               String    @id @default(cuid())
  priceItemId      String
  languageCode     String
  label            String
  shortDescription String?
  priceItem        PriceItem @relation(fields: [priceItemId], references: [id])
}

model PriceUpdateLog {
  id           String    @id @default(cuid())
  priceItemId  String
  oldPriceHt   Float
  newPriceHt   Float
  updateMethod String    @default("manual")
  indexRef     String?
  updatedById  String?
  updatedAt    DateTime  @default(now())
  priceItem    PriceItem @relation(fields: [priceItemId], references: [id])
  updatedBy    User?     @relation(fields: [updatedById], references: [id])
}

model MarketIndex {
  id          String   @id @default(cuid())
  countryId   String
  code        String
  label       String
  periodDate  DateTime
  value       Float
  publishedAt DateTime
  sourceUrl   String?
  country     Country  @relation(fields: [countryId], references: [id])
}

model RegionalCoefficient {
  id          String    @id @default(cuid())
  countryId   String
  regionId    String
  costLotId   String?
  coefficient Float
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  costLot     CostLot?  @relation(fields: [costLotId], references: [id])
  country     Country   @relation(fields: [countryId], references: [id])
  region      Region    @relation(fields: [regionId], references: [id])
}

model QualityCoefficient {
  id            String      @id @default(cuid())
  finishLevelId String
  costLotId     String?
  coefficient   Float
  costLot       CostLot?    @relation(fields: [costLotId], references: [id])
  finishLevel   FinishLevel @relation(fields: [finishLevelId], references: [id])
}

model ComplexityCoefficient {
  id             String   @id @default(cuid())
  complexityCode String
  costLotId      String?
  coefficient    Float
  costLot        CostLot? @relation(fields: [costLotId], references: [id])
}

model CalculationRule {
  id                String          @id @default(cuid())
  ruleCode          String          @unique
  name              String
  ruleType          String          @default("condition")
  inputSchemaJson   String?
  formulaExpression String?
  outputTarget      String?
  priority          Int             @default(0)
  isActive          Boolean         @default(true)
  countryId         String?
  actionJson        String?
  conditionJson     String?
  labelFr           String?
  labelTr           String?
  regionScope       String?
  country           Country?        @relation(fields: [countryId], references: [id])
  conditions        RuleCondition[]
}

model RuleCondition {
  id           String          @id @default(cuid())
  ruleId       String
  fieldName    String
  operator     String
  compareValue String
  rule         CalculationRule @relation(fields: [ruleId], references: [id])
}

model CalculationResult {
  id               String                  @id @default(cuid())
  projectVersionId String
  totalCostHt      Float
  totalCostTva     Float
  totalCostTtc     Float
  costPerM2Ht      Float
  costPerM2Ttc     Float
  confidenceLevel  String                  @default("indicatif")
  breakdownJson    String?
  createdAt        DateTime                @default(now())
  projectVersion   ProjectVersion          @relation(fields: [projectVersionId], references: [id])
  lines            CalculationResultLine[]
}

model CalculationResultLine {
  id                      String            @id @default(cuid())
  calculationResultId     String
  costLotId               String
  quantity                Float
  unit                    String
  unitPriceHt             Float
  lineTotalHt             Float
  appliedCoefficientsJson String?
  calculationResult       CalculationResult @relation(fields: [calculationResultId], references: [id])
  costLot                 CostLot           @relation(fields: [costLotId], references: [id])
}

model Report {
  id               String         @id @default(cuid())
  projectVersionId String
  reportType       String         @default("summary")
  languageCode     String         @default("fr")
  filePath         String?
  generatedById    String?
  generatedAt      DateTime       @default(now())
  generatedBy      User?          @relation(fields: [generatedById], references: [id])
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
}
