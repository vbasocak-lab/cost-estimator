    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "next": "16.2.2",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.9.0",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "tsx": "^4.21.0",
